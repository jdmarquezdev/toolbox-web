---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiGet } from "../../lib/api";
import { resolveToolMediaUrl } from "../../lib/media";

const { id: idOrSlug } = Astro.params;
let tool: any;

try {
  tool = await apiGet(`/api/public/tools/${idOrSlug}`, { origin: Astro.url.origin });
} catch {
  return Astro.redirect("/");
}

if (tool.slug && tool.slug !== idOrSlug) {
  return Astro.redirect(`/tools/${tool.slug}`, 301);
}

const mediaUrl = resolveToolMediaUrl(tool);

const sourceIconClassByType: Record<string, string> = {
  github: "icon-source-github",
  youtube: "icon-source-youtube",
  website: "icon-source-website",
  article: "icon-source-article",
  x: "icon-source-x",
  other: "icon-source-other"
};

const sourceLabelByType: Record<string, string> = {
  github: "GitHub",
  youtube: "YouTube",
  website: "Web",
  article: "Articulo",
  x: "X",
  other: "Other"
};

const sourceIconClass = sourceIconClassByType[tool.sourceType ?? ""] ?? "icon-source-other";
const sourceLabel = sourceLabelByType[tool.sourceType ?? ""] ?? "Other";
---

<BaseLayout title={`${tool.title ?? "Tool"} | Toolbox`} description={tool.description ?? "Detalle de herramienta"}>
  <section class="detail-shell">
    <div class="detail-media">
      {mediaUrl ? (
        <img
          src={mediaUrl}
          alt={tool.title ? `Imagen de ${tool.title}` : "Preview de herramienta"}
        />
      ) : (
        <div class="tool-placeholder">{(tool.title ?? "AI").slice(0, 2)}</div>
      )}
    </div>
    <article class="detail-panel">
      <header class="section-head" style="gap:.35rem;">
        <div class="section-head-text">
          <h1 class="section-title" style="font-size:clamp(1.7rem,2.4vw,2.3rem);">{tool.title ?? "Sin título"}</h1>
          <p class="section-subtitle">{tool.description ?? "Sin descripción"}</p>
        </div>
      </header>
      {tool.notesPublic ? <p class="tool-desc">{tool.notesPublic}</p> : null}

      <div class="detail-bottom-row">
        <span class="chip chip-with-label" aria-label={`Fuente: ${tool.sourceType ?? "other"}`} title={tool.sourceType ?? "other"}>
          <span class={`icon-mask ${sourceIconClass}`} aria-hidden="true"></span>
          <span>{sourceLabel}</span>
        </span>

        <div class="detail-actions">
          <a href={tool.url} target="_blank" rel="noreferrer" class="action-btn action-btn-accent icon-only-btn" aria-label="Visitar herramienta" title="Visitar herramienta">
            <span class="icon-mask icon-visit" aria-hidden="true"></span>
          </a>
          <a href="/" class="action-btn action-btn-accent icon-only-btn" aria-label="Volver" title="Volver">
            <span class="icon-mask icon-back" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
